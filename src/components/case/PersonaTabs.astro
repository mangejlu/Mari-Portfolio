---
interface Persona { role: string; tag: string; initials: string; needs: string[]; pains: string[] }
interface Props { personas: Persona[] }
const { personas } = Astro.props;
const id = 'p-' + Math.random().toString(36).slice(2, 8);

/** Personas one at a time — three columns of bullets is a wall, tabs are a choice. */
---

<div class="personas" id={id}>
  <div class="personas__tabs" role="tablist" aria-label="User types">
    {personas.map((p, i) => (
      <button
        type="button"
        role="tab"
        id={`${id}-t${i}`}
        aria-controls={`${id}-p${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-cursor="meet them"
      >
        <span class="personas__initials" aria-hidden="true">{p.initials}</span>
        <span class="personas__role">{p.role}</span>
        <span class="personas__tag">{p.tag}</span>
      </button>
    ))}
  </div>

  {personas.map((p, i) => (
    <div
      class="personas__panel"
      role="tabpanel"
      id={`${id}-p${i}`}
      aria-labelledby={`${id}-t${i}`}
      hidden={i !== 0}
    >
      <div class="personas__col">
        <p class="personas__h">Needs</p>
        <ul>{p.needs.map((n) => <li>{n}</li>)}</ul>
      </div>
      <div class="personas__col personas__col--pain">
        <p class="personas__h">Pain points</p>
        <ul>{p.pains.map((n) => <li>{n}</li>)}</ul>
      </div>
    </div>
  ))}
</div>

<style>
  .personas__tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .personas__tabs button {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 10px;
    border: 1px solid var(--border);
    border-radius: 30px;
    background: var(--card);
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .personas__tabs button[aria-selected='true'] {
    border-color: color-mix(in oklab, var(--accent) 70%, var(--border));
    background: color-mix(in oklab, var(--accent) 12%, var(--card));
  }

  .personas__initials {
    width: 28px; height: 28px;
    display: grid; place-items: center;
    border-radius: 50%;
    background: color-mix(in oklab, var(--accent) 55%, var(--card));
    font-size: 11px;
    flex: none;
  }
  .personas__role { font-size: 13.5px; }
  .personas__tag {
    font-size: 10px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .personas__panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .personas__col { background: var(--card); padding: 22px; }
  .personas__h {
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 12px;
  }
  .personas__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .personas__col li {
    position: relative;
    padding-left: 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .personas__col li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.6em;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .personas__col--pain li::before { background: var(--danger); opacity: 0.7; }
</style>

<script>
  function initPersonas() {
    for (const root of document.querySelectorAll<HTMLElement>('.personas')) {
      if (root.dataset.wired === 'true') continue;
      root.dataset.wired = 'true';

      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

      const select = (i: number) => {
        tabs.forEach((tab, j) => {
          const on = i === j;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(tab.getAttribute('aria-controls')!);
          if (panel) panel.hidden = !on;
        });
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        // Standard tablist keyboard behaviour: arrows move, and move focus.
        tab.addEventListener('keydown', (e) => {
          const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!delta) return;
          e.preventDefault();
          const next = (i + delta + tabs.length) % tabs.length;
          select(next);
          tabs[next].focus();
        });
      });
    }
  }

  initPersonas();
  document.addEventListener('astro:page-load', initPersonas);
</script>
