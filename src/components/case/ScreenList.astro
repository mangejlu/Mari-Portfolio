---
interface Screen { title: string; purpose: string; notes: string[]; solves?: string }
interface Props { screens: Screen[] }
const { screens } = Astro.props;
---

<ol class="screens">
  {screens.map((s, i) => (
    <li class="screen">
      <div class="screen__head">
        <span class="screen__num">{String(i + 1).padStart(2, '0')}</span>
        {s.solves && <span class="screen__solves">{s.solves}</span>}
      </div>
      <h3 class="screen__title">{s.title}</h3>
      <p class="screen__purpose"><span>Why it exists.</span> {s.purpose}</p>
      <ul class="screen__notes">{s.notes.map((n) => <li>{n}</li>)}</ul>
    </li>
  ))}
</ol>

<style>
  .screens {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .screen {
    display: flex; flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    padding: 22px;
  }
  .screen__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 10px; }
  .screen__num { font-size: 11px; color: var(--accent); filter: brightness(0.85); font-variant-numeric: tabular-nums; }
  .screen__solves {
    font-size: 10px; letter-spacing: .04em; text-transform: uppercase;
    color: var(--ink-soft);
    background: color-mix(in oklab, var(--accent) 16%, var(--card));
    border: 1px solid color-mix(in oklab, var(--accent) 34%, var(--border));
    padding: 3px 8px; border-radius: 10px;
  }
  .screen__title { font-size: 18px; line-height: 1.25; margin-bottom: 8px; }
  .screen__purpose { font-size: 13.5px; line-height: 1.55; color: var(--ink-soft); margin-bottom: 14px; }
  .screen__purpose span { color: var(--ink); }
  .screen__notes {
    list-style: none; margin: 0; padding: 14px 0 0;
    border-top: 1px solid var(--border);
    display: grid; gap: 8px; margin-top: auto;
  }
  .screen__notes li {
    position: relative; padding-left: 15px;
    font-size: 12.5px; line-height: 1.5; color: var(--ink-soft);
  }
  .screen__notes li::before {
    content: ''; position: absolute; left: 0; top: .58em;
    width: 4px; height: 4px; border-radius: 50%; background: var(--accent);
  }
</style>
