---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import { site } from '../data/site';
import { PALETTE } from '../lib/mural';

/**
 * The mural, before it opens.
 *
 * A "coming soon" page is usually an apology. This one is a preview instead:
 * the wall it is promising is made of coloured squares, so the page shows
 * those squares filling in one by one. You can see what the thing will be,
 * which is the only reason to put a placeholder in front of someone.
 */

// Enough tiles to read as a wall, in a fixed order so the animation is
// deterministic rather than a different mess on every visit.
const TILES = Array.from({ length: 48 }, (_, i) => ({
  colour: PALETTE[(i * 5) % PALETTE.length].hex,
  delay: ((i * 137) % 48) * 0.055,
}));
---

<BaseLayout
  title="the mural"
  description="A shared wall where every visitor leaves a colour. Opening soon."
  chapter="mural"
  aura={['#F5B48C', '#FFF2A8', '#F5AFC9']}
>
  <section class="soon">
    <div class="shell on-aura on-aura--start">
      <Reveal>
        <h1 class="chapter-title">
          <span class="chapter-num">chapter 03</span> the mural
        </h1>
      </Reveal>

      <Reveal delay={80}>
        <p class="soon__badge"><span class="soon__dot" aria-hidden="true"></span>coming soon</p>
      </Reveal>

      <Reveal delay={140}>
        <p class="soon__lead">
          A shared wall. Every visitor picks a colour, leaves a line, and it
          stays for whoever comes next. I am building the part that makes it
          properly shared, so it is not open just yet.
        </p>
      </Reveal>

      <Reveal delay={200}>
        <div class="soon__wall" aria-hidden="true">
          {TILES.map((t) => (
            <span
              class="soon__tile"
              style={`--tile:${t.colour}; --delay:${t.delay}s`}
            ></span>
          ))}
        </div>
      </Reveal>

      <Reveal delay={260}>
        <p class="soon__foot">
          In the meantime, there is{' '}
          <a href="/work/" data-chapter="work" data-cursor="view">the work</a>,{' '}
          <a href="/about/" data-chapter="about" data-cursor="hi">a bit about me</a>,
          or you can just{' '}
          <a href={`mailto:${site.email}`} data-cursor="write to me">say hi properly</a>.
        </p>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .soon {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
  }

  .soon__badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    padding: 7px 15px 7px 12px;
    border-radius: 20px;
    background: var(--card);
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--border));
    font-size: 12.5px;
    letter-spacing: 0.04em;
  }
  .soon__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: soon-pulse 2.4s ease-in-out infinite;
  }
  @keyframes soon-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.4; transform: scale(0.75); }
  }

  .soon__lead {
    margin-top: 20px;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  /* A preview of the thing itself: the wall filling in, one square at a time. */
  .soon__wall {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 9px;
    margin: 36px 0 0;
    max-width: 620px;
  }
  .soon__tile {
    aspect-ratio: 1;
    border-radius: 9px;
    background: var(--tile);
    opacity: 0;
    animation: tile-in 5.6s ease-in-out infinite;
    animation-delay: var(--delay);
  }
  @keyframes tile-in {
    0%        { opacity: 0;    transform: scale(0.5); }
    12%       { opacity: 0.95; transform: scale(1); }
    55%       { opacity: 0.95; transform: scale(1); }
    72%, 100% { opacity: 0.08; transform: scale(0.86); }
  }

  .soon__foot {
    margin-top: 40px;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .soon__foot a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .soon__dot { animation: none; }
    /* Show the finished wall rather than an empty grid. */
    .soon__tile { animation: none; opacity: 0.9; }
  }

  @media (max-width: 900px) {
    .soon__wall { grid-template-columns: repeat(8, 1fr); }
  }

  @media (max-width: 640px) {
    .soon { padding-top: 100px; }
    .soon__wall { grid-template-columns: repeat(6, 1fr); gap: 7px; }
  }
</style>
