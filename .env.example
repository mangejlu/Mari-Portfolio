# Your live domain. Canonical and Open Graph tags are built from this, so it
# must be yours: pointing it elsewhere hands your SEO to another site.
# Example: SITE_URL=https://mariangel.com
SITE_URL=

# The mural. Both values are safe to expose: the anon key only grants what the
# row level security policies in supabase/schema.sql allow (read the wall, add
# one tile). Everything else is denied at the database.
#
# Without these the mural still runs, backed by this browser's own storage, so
# you can review the experience before setting anything up.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
